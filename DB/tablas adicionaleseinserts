USE questforgood_in5bv;

ALTER TABLE usuarios ADD COLUMN foto_url VARCHAR(255) NULL;

CREATE TABLE intereses (
    id INT AUTO_INCREMENT PRIMARY KEY,
    usuario_id INT NOT NULL,
    juego_id INT NOT NULL,
    fecha TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UNIQUE KEY uq_interes (usuario_id, juego_id),
    FOREIGN KEY (usuario_id) REFERENCES usuarios(id) ON DELETE CASCADE,
    FOREIGN KEY (juego_id) REFERENCES juegos(id) ON DELETE CASCADE
);

CREATE TABLE cupones (
    id INT AUTO_INCREMENT PRIMARY KEY,
    codigo VARCHAR(30) NOT NULL UNIQUE,
    descripcion VARCHAR(150),
    descuento_extra DECIMAL(5,2) NOT NULL,
    tipo VARCHAR(20) NOT NULL DEFAULT 'exclusivo',
    dias_vigencia INT NOT NULL DEFAULT 7
);

CREATE TABLE usuarios_cupones (
    id INT AUTO_INCREMENT PRIMARY KEY,
    usuario_id INT NOT NULL,
    cupon_id INT NOT NULL,
    usado BOOLEAN NOT NULL DEFAULT FALSE,
    fecha_obtenido TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    fecha_expira DATETIME NULL,
    FOREIGN KEY (usuario_id) REFERENCES usuarios(id) ON DELETE CASCADE,
    FOREIGN KEY (cupon_id) REFERENCES cupones(id)
);

ALTER TABLE compras ADD COLUMN usuario_cupon_id INT NULL;

ALTER TABLE compras ADD CONSTRAINT fk_compras_usuario_cupon FOREIGN KEY (usuario_cupon_id) REFERENCES usuarios_cupones(id);

