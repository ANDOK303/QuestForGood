UPDATE causas c
SET c.total_recaudado = (SELECT COALESCE(SUM(m.monto_donado), 0) FROM compras m WHERE m.causa_id = c.id)
WHERE c.id > 0;

UPDATE usuarios u
SET u.total_donado = (SELECT COALESCE(SUM(m.monto_donado), 0) FROM compras m WHERE m.usuario_id = u.id)
WHERE u.id > 0;