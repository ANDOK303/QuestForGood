    UNION ALL SELECT 'luis@test.com', 'Cyberpunk 2077', 'Energía Solar Comunitaria', 'Transferencia bancaria', '2026-08-25 19:00:00'
    UNION ALL SELECT 'camila@test.com', 'It Takes Two', 'Becas Escolares', 'Tarjeta de débito', '2026-09-02 17:45:00'
    UNION ALL SELECT 'javier@test.com', 'Civilization VI', 'Huertos Urbanos', 'PayPal', '2026-09-08 15:10:00'
    UNION ALL SELECT 'daniela@test.com', 'Among Us', 'Rescate de Fauna Silvestre', 'Tarjeta de crédito', '2026-09-14 22:00:00'
    UNION ALL SELECT 'mateo@test.com', 'DOOM Eternal', 'Salud para Todos', 'Tarjeta de crédito', '2026-09-21 18:35:00'
    UNION ALL SELECT 'ana@test.com', 'Hades', 'Reforestación Global', 'PayPal', '2026-09-27 12:20:00'
    UNION ALL SELECT 'carlos@test.com', 'Elden Ring', 'Agua para Todos', 'Tarjeta de crédito', '2026-10-01 20:50:00'
    UNION ALL SELECT 'sofia@test.com', 'Cyberpunk 2077', 'Educación Digital', 'PayPal', '2026-10-03 14:25:00'
